{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jiraf",
  "identifier": "com.dmbuil.jiraf",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "jiraf", "width": 1400, "height": 900, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: jiraf: http://jiraf.localhost; connect-src ipc: http://ipc.localhost; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["app-icons/32x32.png", "app-icons/128x128.png", "app-icons/128x128@2x.png", "app-icons/icon.icns", "app-icons/icon.ico"]
  }
}
